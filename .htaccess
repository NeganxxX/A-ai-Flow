Options -Indexes
DirectoryIndex index.php

# Cabeçalhos básicos de segurança compatíveis com o XAMPP/Apache.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^\.(env|git|sql|ini|log)$">
    Require all denied
</FilesMatch>

# Nunca publique cópias de backup, temporários ou arquivos de editor.
<FilesMatch "\.(bak|old|orig|save|swp|swo|tmp)$">
    Require all denied
</FilesMatch>

# Arquivos de configuração local não devem ser servidos como texto.
<Files "local.php">
    Require all denied
</Files>
